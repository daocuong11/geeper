// Geeper: base local en SQLite (~/geeper-data/geeper.db). La fuente de verdad de cada proyecto es
// su geeper.json; aquí se guardan el índice, el historial, la cola y los renders.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Plantilla {
  id          String   @id @default(cuid())
  slug        String   @unique
  nombre      String
  /// Datos de la plantilla (colores, tipografía, logo, CTA, tarjeta final, voz, música). Ver src/lib/plantillas.ts
  datos       Json
  creado      DateTime @default(now())
  actualizado DateTime @updatedAt
}

model Lote {
  id        String     @id @default(cuid())
  nombre    String
  formato   String
  plantilla String
  temas     Json
  creado    DateTime   @default(now())
  proyectos Proyecto[]
}

model Proyecto {
  id             String     @id @default(cuid())
  /// Nombre de la carpeta en ~/geeper-data/
  slug           String     @unique
  nombre         String
  tema           String
  formato        String
  plantilla      String
  flujo          String     @default("fabrica")
  /// borrador | generando | ensamblado | qc | entregado | fallido
  estado         String     @default("borrador")
  versionActual  Int        @default(0)
  loteId         String?
  orden          Int        @default(0)
  lote           Lote?      @relation(fields: [loteId], references: [id])
  creado         DateTime   @default(now())
  actualizado    DateTime   @updatedAt
  versiones      Version[]
  assets         Asset[]
  trabajos       Trabajo[]
  renders        Render[]
}

model Version {
  id         String   @id @default(cuid())
  proyectoId String
  numero     Int
  nota       String
  /// sha256 del geeper.json guardado
  hash       String
  json       String
  creado     DateTime @default(now())
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@unique([proyectoId, numero])
}

model Asset {
  id          String   @id
  proyectoId  String
  /// video | audio | imagen
  tipo        String
  /// Relativa a la carpeta del proyecto
  ruta        String
  hash        String
  /// archivo | mpt | tts | wan
  source      String
  prompt      String?
  semilla     Int?
  modelo      String?
  licencia    String
  procedencia Json
  creado      DateTime @default(now())
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

model Trabajo {
  id          String    @id @default(cuid())
  proyectoId  String?
  /// mpt.generar | proyecto.importar | voz.regenerar | render.entregar
  tipo        String
  /// Ejecutor que lo corre: mpt | voz | render
  motor       String
  /// pendiente | corriendo | hecho | fallido | interrumpido | cancelado
  estado      String    @default("pendiente")
  usaGpu      Boolean   @default(false)
  intentos    Int       @default(0)
  maxIntentos Int       @default(2)
  leaseUntil  DateTime?
  workerId    String?
  input_hash  String?
  payload     Json
  resultado   Json?
  etapa       String    @default("")
  progreso    Float     @default(0)
  /// Ruta del log del trabajo (relativa a ~/geeper-data)
  log         String?
  error       String?
  prioridad   Int       @default(0)
  creado      DateTime  @default(now())
  iniciado    DateTime?
  terminado   DateTime?
  actualizado DateTime  @updatedAt
  proyecto    Proyecto? @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@index([motor, estado])
}

model Render {
  id            String   @id @default(cuid())
  proyectoId    String
  versionNumero Int
  /// shorts-9x16 | youtube-16x9 | cuadrado-1x1
  perfil        String
  ruta          String
  /// renderizado | aprobado | rechazado
  estado        String
  informeQc     Json?
  duracion      Float?
  segundos      Float?
  trabajoId     String?
  creado        DateTime @default(now())
  proyecto      Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
}

/// Pares clave/valor del sistema (último latido del worker, etc.).
model Sistema {
  clave       String   @id
  valor       String
  actualizado DateTime @updatedAt
}
